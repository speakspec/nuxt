{
  "name": "@speakspec/nuxt",
  "version": "0.0.1",
  "description": "AIDP 0.3 publishing channel for Nuxt — exposes /.well-known/aidp.json and friends, fetches signed content + pointer payloads from SpeakSpec, receives §8.10 cache-invalidation webhooks.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/speakspec/nuxt.git"
  },
  "homepage": "https://docs.speakspec.com/developer/sdk-nuxt",
  "bugs": {
    "url": "https://github.com/speakspec/nuxt/issues"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    }
  },
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ]
    }
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "generate:version": "node scripts/generate-version.mjs",
    "prepare": "node scripts/generate-version.mjs",
    "prepack": "pnpm generate:version && nuxt-module-build build",
    "build": "pnpm generate:version && nuxt-module-build build",
    "dev:prepare": "pnpm generate:version && nuxt-module-build build --stub && nuxt-module-build prepare && nuxi prepare playground",
    "lint": "eslint .",
    "test": "pnpm generate:version && vitest run --passWithNoTests",
    "test:watch": "pnpm generate:version && vitest watch",
    "test:types": "pnpm generate:version && vue-tsc --noEmit && cd playground && vue-tsc --noEmit",
    "speakspec": "node bin/speakspec.mjs"
  },
  "bin": {
    "speakspec": "./bin/speakspec.mjs"
  },
  "dependencies": {
    "@nuxt/kit": "^4.0.0",
    "defu": "^6.1.4",
    "ofetch": "^1.4.1"
  },
  "peerDependencies": {
    "nuxt": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nuxt/devtools": "^2.0.0",
    "@nuxt/eslint-config": "^1.0.0",
    "@nuxt/module-builder": "^1.0.0",
    "@nuxt/schema": "^4.0.0",
    "@nuxt/test-utils": "^3.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "globals": "^17.6.0",
    "nuxt": "^4.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.59.1",
    "vitest": "^3.0.0",
    "vue-tsc": "^2.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
